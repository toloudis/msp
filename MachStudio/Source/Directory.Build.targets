<?xml version="1.0" encoding="utf-8"?>
<!--
    GUI toolkit selection for the MachStudio projects (see the
    Directory.Build.props at the top of the repository for MspGuiToolkit).

    Qt: the Qt 6 settings from ToolUIQt/qt6.props are added (they define
        MSP_GUI_QT, which keeps wxWidgets off), sources in wxGUI folders
        are not compiled, and the Qt runtime is copied next to the
        executable after linking.
    Wx: sources in qtGUI folders are not compiled.
  -->
<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\..\LibXLT\ToolUIQt\qt6.props" Condition="'$(MspGuiToolkit)' == 'Qt'" />

  <ItemGroup Condition="'$(MspGuiToolkit)' != 'Wx'">
    <ClCompile Remove="$(MSBuildThisFileDirectory)**\wxGUI\**\*.cpp" />
  </ItemGroup>
  <ItemGroup Condition="'$(MspGuiToolkit)' != 'Qt'">
    <ClCompile Remove="$(MSBuildThisFileDirectory)**\qtGUI\**\*.cpp" />
  </ItemGroup>

  <!-- Copy the Qt DLLs and plugins the executable needs next to it -->
  <Target Name="MspDeployQt"
          AfterTargets="Build"
          Condition="'$(MspGuiToolkit)' == 'Qt' and '$(ConfigurationType)' == 'Application' and Exists('$(MspQtDir)bin\windeployqt.exe')">
    <PropertyGroup>
      <MspDeployQtMode Condition="$(Configuration.Contains('Debug'))">--debug</MspDeployQtMode>
      <MspDeployQtMode Condition="'$(MspDeployQtMode)' == ''">--release</MspDeployQtMode>
    </PropertyGroup>
    <Exec Command="&quot;$(MspQtDir)bin\windeployqt.exe&quot; $(MspDeployQtMode) --no-translations --no-compiler-runtime --no-opengl-sw --no-system-d3d-compiler --no-quick-import &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
