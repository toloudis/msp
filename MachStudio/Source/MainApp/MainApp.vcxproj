  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Each configuration builds into its own run directory
       (MachStudio/MachStudio-x64-<Qt|Wx|RenderNode>-<Debug|Release>/). Next to the exe
       go the runtime data (MachStudio/Runtime/Data, found next to the exe), the 3rdParty
       DLLs every build needs (libpng, zlibwapi) and, in Wx builds, the wxWidgets DLLs of
       that Debug/Release. vcpkg copies its own DLLs, and windeployqt Qt's
       (Directory.Build.targets). Unchanged files are skipped. -->
  <Target Name="MspDeployRuntime" AfterTargets="Build">
    <PropertyGroup>
      <MspWxDllSuffix Condition="'$(MspBaseConfiguration)' == 'Debug'">ud</MspWxDllSuffix>
      <MspWxDllSuffix Condition="'$(MspBaseConfiguration)' != 'Debug'">u</MspWxDllSuffix>
    </PropertyGroup>
    <ItemGroup>
      <MspRuntimeData Include="$(ProjectDir)..\..\Runtime\Data\**\*" />
      <MspRuntimeDll Include="$(ProjectDir)..\..\..\3rdParty\Libs\$(Platform)\libpng16.dll;$(ProjectDir)..\..\..\3rdParty\Libs\$(Platform)\zlibwapi.dll" />
      <MspRuntimeDll Include="$(ProjectDir)..\..\..\3rdParty\WxWidgets\lib\vc14x_x64_dll\wx*32$(MspWxDllSuffix)_*.dll" Condition="'$(MspGuiToolkit)' == 'Wx'" />
    </ItemGroup>
    <Copy SourceFiles="@(MspRuntimeData)" DestinationFiles="@(MspRuntimeData->'$(OutDir)Data\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MspRuntimeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <ProjectExtensions>
    <VisualStudio>
      <UserProperties RESOURCE_FILE="app.rc" />
    </VisualStudio>
  </ProjectExtensions>
</Project>