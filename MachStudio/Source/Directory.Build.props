<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings shared by the MachStudio projects (imported automatically by
    MSBuild for every project under this directory).

    MspGuiToolkit chooses the GUI toolkit:
      Qt  - the Qt 6 interface (qtGUI folders, LibXLT/ToolUIQt)
      Wx  - the wxWidgets interface (wxGUI folders, LibXLT/ToolUIWx)

    Change the default here, or override it per build with the
    MSP_GUI_TOOLKIT environment variable or -p:MspGuiToolkit=Wx.
    See Directory.Build.targets for what the choice changes.
  -->
<Project>
  <PropertyGroup>
    <MspGuiToolkit Condition="'$(MspGuiToolkit)' == '' and '$(MSP_GUI_TOOLKIT)' != ''">$(MSP_GUI_TOOLKIT)</MspGuiToolkit>
    <MspGuiToolkit Condition="'$(MspGuiToolkit)' == ''">Qt</MspGuiToolkit>
  </PropertyGroup>
</Project>
