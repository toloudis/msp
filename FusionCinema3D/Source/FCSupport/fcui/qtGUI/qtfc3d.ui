        <string notr="true">QSlider::groove:horizontal { background-color: rgb(220,220,220); border: 1px solid #bbb; height: 10px; border-radius: 4px; } QSlider::handle:horizontal { width: 10px; background:QLinearGradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #CCC, stop: 1 #888); margin-top: -2px; /* expand outside the groove */ margin-bottom: -2px; border-radius: 4px; } QSlider::handle:horizontal:hover{ width: 10px; background:QLinearGradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #AAA, stop: 1 #555); margin-top: -2px; /* expand outside the groove */ margin-bottom: -2px; border-radius: 4px; } QSlider::sub-page:horizontal{ background: qlineargradient(x1: 0, y1:0, x2: 0, y2:1, stop: 0 #5CF, stop: 1 #0FF); background: qlineargradient(x1: 0, y1:0.2, x2: 1, y2:1, stop: 0 #DFF, stop: 1 #0CF); border: 1px solid #777; height: 10px; border-radius: 4px; } QSlider::add-page:horizontal{ background-color: rgb(220,220,220); border: 1px solid #777; height: 10px; border-radius: 4px; } </string>
