float3 mi_noise_fade(
	float3 t	/* 0-1 interpolation parameter */
)
{
	return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

float4 mi_noise_fade(
	float4 t   /* 0-1 interpolation parameter */
)
{
	return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

float mi_perm(
	Texture1d noise_perm_texture, /* The permutation table */
	float x					  /* The texture coordinate / permutation */
	)
{
//	x = (x + 0.5/256.0)*(255.0/256.0);
	return (tex1D(noise_perm_texture, x)).x;
}

float mi_grad(
	Texture1d noise_grad_texture, /* The gradient table */
	float x,					  /* The texture coordinate / gradient */
	float3 p					  /* A vector to dot with the gradient */
	)					  
{
//	x = (x + 0.5/16.0)*(15.0/16.0);
	float3 v = tex1D(noise_grad_texture, x).xyz;
	v = v*2.0 - 1.0;
	/* get rid of epsilon offset - values should be -1, 0, or 1 */
	v *= floor(abs(v));
	return dot(v, p);
}

float mi_grad(
	Texture1d noise_grad_texture,/* The gradient table */
	float x,					 /* The texture coordinate / gradient */
	float4 p					 /* A vector to combine with the gradient */
	)
{
//	x = (x + 0.5/32.0)*(31.0/32.0);
	float4 v = tex1D(noise_grad_texture, x);
	v = v*2.0 - 1.0;
	/* get rid of epsilon offset - values should be -1, 0, or 1 */
	v *= floor(abs(v));
	return dot(v, p);
}

float mi_inoise(
	float3 p,						/* Noise Position */
	Texture1d noise_perm_texture,	/* The permutation table */
	Texture1d noise_grad_texture	/* The gradient table */
)
{
	float3 P;
	P = fmod(floor(p), 256.0);
	
  	p -= floor(p);
	float3 f = mi_noise_fade(p);

	P = P / 255.0;
	float one = 1.0 / 255.0;
		
  	float A = mi_perm(noise_perm_texture, P.x) + P.y;
  	float4 AA;
  	AA.x = mi_perm(noise_perm_texture, A) + P.z;
	AA.y = mi_perm(noise_perm_texture, A + one) + P.z;
  	float B =  mi_perm(noise_perm_texture, P.x + one) + P.y;
  	AA.z = mi_perm(noise_perm_texture, B) + P.z;
  	AA.w = mi_perm(noise_perm_texture, B + one) + P.z;
  
  	return lerp(
                    lerp(
                        lerp(
                            mi_grad(noise_grad_texture,
                                    mi_perm(noise_perm_texture,AA.x), 
  							 p ),  
                            mi_grad(noise_grad_texture,
                                    mi_perm(noise_perm_texture,AA.z), 
                                    p + float3(-1.0,0.0,0.0)),
                            f.x),
                        lerp(
                            mi_grad(noise_grad_texture,
                                    mi_perm(noise_perm_texture,AA.y), 
				    p + float3(0.0,-1.0,0.0)),
                            mi_grad(noise_grad_texture,
                                    mi_perm(noise_perm_texture,AA.w), 
                                    p + float3(-1.0,-1.0,0.0)),
                            f.x),
                        f.y),  
                    lerp(
                        lerp(
                            mi_grad(noise_grad_texture,
                                    mi_perm(noise_perm_texture,AA.x+one), 
				    p + float3(0.0,0.0,-1.0)),
                            mi_grad(noise_grad_texture,
                                    mi_perm(noise_perm_texture,AA.z+one), 
                                    p + float3(-1.0,0.0,-1.0)),
                            f.x),
                        lerp(
                            mi_grad(noise_grad_texture,
                                    mi_perm(noise_perm_texture,AA.y+one), 
				    p + float3(0.0,-1.0,-1.0)),
                            mi_grad(noise_grad_texture,
                                    mi_perm(noise_perm_texture,AA.w+one), 
                                    p + float3(-1.0,-1.0,-1.0)),
                            f.x),
                        f.y),
                    f.z);

}

float mi_inoise(
	float4 p,						/* Noise Position */
	Texture1d noise_perm_texture,	/* The permutation table */
	Texture1d noise_grad_texture	/* The gradient table */
)
{
	float4 P = fmod(floor(p), 256.0);
  	p -= floor(p);
	float4 f = mi_noise_fade(p);

	P = P / 255.0;
	float one = 1.0 / 255.0;
	
	//Texture1d npt = noise_perm_texture;
	//Texture1d ngt = noise_grad_texture;
	 
  	float A  = mi_perm(noise_perm_texture, P.x) + P.y;
  	float AA = mi_perm(noise_perm_texture, A) + P.z;
  	float AB = mi_perm(noise_perm_texture, A + one) + P.z;
  	float B  = mi_perm(noise_perm_texture, P.x + one) + P.y;
  	float BA = mi_perm(noise_perm_texture, B) + P.z;
  	float BB = mi_perm(noise_perm_texture, B + one) + P.z;

	float AAA = mi_perm(noise_perm_texture, AA)+P.w;
	float AAB = mi_perm(noise_perm_texture, AA+one)+P.w;
    float ABA = mi_perm(noise_perm_texture, AB)+P.w;
    float ABB = mi_perm(noise_perm_texture, AB+one)+P.w;
    float BAA = mi_perm(noise_perm_texture, BA)+P.w;
    float BAB = mi_perm(noise_perm_texture, BA+one)+P.w;
    float BBA = mi_perm(noise_perm_texture, BB)+P.w;
    float BBB = mi_perm(noise_perm_texture, BB+one)+P.w;
 
  	return lerp(
  	            lerp(
                        lerp(
                            lerp(
                                mi_grad(noise_grad_texture, 
								  mi_perm(noise_perm_texture, AAA), 
  								  p ),  
                                mi_grad(noise_grad_texture,
                                        mi_perm(noise_perm_texture,BAA), 
				        p + float4(-1.0,0.0,0.0,0.0)),
                                f.x),
                            lerp(
                                mi_grad(noise_grad_texture,
                                        mi_perm(noise_perm_texture,ABA), 
					p + float4(0.0,-1.0,0.0,0.0)),
                                mi_grad(noise_grad_texture,
                                        mi_perm(noise_perm_texture,BBA), 
                                        p + float4(-1.0,-1.0,0.0,0.0)),
                                f.x),
                            f.y),
                        lerp(
                            lerp(
                                mi_grad(noise_grad_texture,
                                        mi_perm(noise_perm_texture,AAB), 
				        p + float4(0.0,0.0,-1.0,0.0)),
                                mi_grad(noise_grad_texture,
                                        mi_perm(noise_perm_texture,BAB), 
                                        p + float4(-1.0,0.0,-1.0,0.0)),
                                f.x),
                            lerp(
                                mi_grad(noise_grad_texture,
                                        mi_perm(noise_perm_texture,ABB), 
					p + float4(0.0,-1.0,-1.0,0.0)),
                                mi_grad(noise_grad_texture,
                                        mi_perm(noise_perm_texture,BBB), 
                                        p + float4(-1.0,-1.0,-1.0,0.0)), 
                                f.x),
                            f.y),
                        f.z),
  	            lerp(
                        lerp(
                            lerp(
                                mi_grad(noise_grad_texture, 
			                mi_perm(noise_perm_texture,AAA+one),
  					p + float4(0.0,0.0,0.0,-1.0)),
                                mi_grad(noise_grad_texture,
                                        mi_perm(noise_perm_texture,BAA+one),
                                        p + float4(-1.0,0.0,0.0,-1.0)),
                                f.x),
                            lerp(
                                mi_grad(noise_grad_texture,
                                        mi_perm(noise_perm_texture,ABA+one),
				        p + float4(0.0,-1.0,0.0,-1.0)),
                                mi_grad(noise_grad_texture,
                                        mi_perm(noise_perm_texture, BBA+one),
                                        p + float4(-1.0,-1.0,0.0,-1.0)),
                                f.x),
                            f.y),
                        lerp(
                            lerp(
                                mi_grad(noise_grad_texture,
                                        mi_perm(noise_perm_texture,AAB+one),
					p + float4(0.0,0.0,-1.0,-1.0)),
                                mi_grad(noise_grad_texture,
                                        mi_perm(noise_perm_texture,BAB+one),
                                        p + float4(-1.0,0.0,-1.0,-1.0)),
                                f.x),
                            lerp(
                                mi_grad(noise_grad_texture,
                                        mi_perm(noise_perm_texture,ABB+one),
					p + float4(0.0,-1.0,-1.0,-1.0)),
                                mi_grad(noise_grad_texture,
                                        mi_perm(noise_perm_texture,BBB+one),
                                        p + float4(-1.0,-1.0,-1.0,-1.0)), 
                                f.x),
                            f.y),
                        f.z),
                    f.w);
}


float octaves(
	float3 p,					  /* Noise Position */
	Texture1d noise_perm_texture, /* The permutation table */
	Texture1d noise_grad_texture, /* The gradient table */
	int octaves,				  /* Number of octaves to sum */
	float lacunarity,			  /* Separation of frequencies */
	float gain,				  /* Successive frequency weighting */
	float freq,				  /* Base frequency */
	float amp					  /* Base frequency weighting */
	)
{
	float sum = 0;	
	for(int i=0; i<octaves; i++) {
		sum += mi_inoise(p*freq, noise_perm_texture, noise_grad_texture)*amp;
		freq *= lacunarity;
		amp *= gain;
	}
	return sum;
}

float octaves_abs(
	float3 p,						/* Noise Position */
	Texture1d noise_perm_texture,	/* The permutation table */
	Texture1d noise_grad_texture,	/* The gradient table */
	int octaves,					/* Number of octaves to sum */
	float lacunarity,				/* Separation of frequencies */
	float gain,					/* Successive frequency weighting */
	float freq,					/* Base frequency */
	float amp						/* Base frequency weighting */
	)
{
	float sum = 0;	
	for(int i=0; i<octaves; i++) {
		sum += abs(mi_inoise(p*freq, 
			noise_perm_texture, 
			noise_grad_texture))*amp;
		freq *= lacunarity;
		amp *= gain;
	}
	return sum;
}

shader Generator_noise
{
	input:
		Texture1d noise_perm_texture      = "noise_perm.dds"
	    {
			description( "The texture containing the permutation table used in "
						 "generating the noise." );
			disable_filtering();
			texture_coord_u("clamp");
		};
		Texture1d noise_grad_texture      = "noise_grad.dds"
	    {
			description( "The texture containing the gradient table used in "
						 "generating the noise." );
			disable_filtering();
			texture_coord_u("clamp");
		};
		float3   noise_position		  = float3(
							    texture_coordinate[0].x,
							    texture_coordinate[0].y,
							    texture_coordinate[0].z)
    	{		
			display_name("Noise Position");
			description( "The location at which the noise function will be "
						 "evaluated." );			
		};
		float    noise_scale			  = 5.0
    	{		
			display_name("Noise Scale");
			soft_range(float(0.0001),float(100));
			description( "A scale factor applied to the position at which the "
						 "noise function will be evaluated." );
		};

	output:
		Color result;

		void main()
		{
			float3 posw = noise_position * noise_scale;

			float n;

			n = mi_inoise(posw, 
						  noise_perm_texture, 
						  noise_grad_texture);
			n = n*0.5 + 0.5;

			result = Color(n.xxx, 1.0);
		}    
}
{
	description( "An operation that will generate a noise pattern." );
}
;

shader Generator_noise_4d 
{
	input:
		Texture1d noise_perm_texture      = "noise_perm.dds"
	    {
			description( "The texture containing the permutation table used in "
						 "generating the noise." );
			disable_filtering();
			texture_coord_u("clamp");
		};
		Texture1d noise_grad_texture      = "noise_grad_4d.dds"
	    {
			description( "The texture containing the gradient table used in "
						 "generating the noise." );
			disable_filtering();
			texture_coord_u("clamp");
		};
		float3   noise_position		  = float3(
							texture_coordinate[0].x,
							texture_coordinate[0].y,
							texture_coordinate[0].z)
    	{		
			display_name("Noise Position");
			description( "The location at which the noise function will be "
						 "evaluated." );			
		};
		float    noise_scale			  = 5.0
    	{		
			display_name("Noise Scale");
			soft_range(float(0.0001),float(100));
			description( "A scale factor applied to the position at which the "
						 "noise function will be evaluated." );
		};
		float    noise_time			  = 0.0
	   	{		
			display_name("Noise Time");
			description( "The time at which the noise function will be "
						 "evaluated." );
		};
		float    noise_time_scale		  = 1.0
    	{		
			display_name("Noise Time Scale");
			soft_range(float(0.0001),float(100));
			description( "A scale factor applied to the time at which the "
						 "noise function will be evaluated." );
		};
    
	output:
		Color result;

		void main()
		{
			float4 posw = float4(noise_position.x,
								   noise_position.y,
								   noise_position.z,
								   noise_time * noise_time_scale) 
								   * noise_scale;

			float n;

			n = mi_inoise(posw, 
						  noise_perm_texture, 
						  noise_grad_texture);
			n = n*0.5 + 0.5;

			result = Color(n.xxx, 1.0);
		}    
}
{
	description( "An operation that will generate a noise pattern." );
}
;

shader Generator_fractal
{
	input:
		Texture1d noise_perm_texture      = "noise_perm.dds"
	    {
			description( "The texture containing the permutation table used "
						 "in generating the noise." );
			disable_filtering();
			texture_coord_u("clamp");
		};
		Texture1d noise_grad_texture      = "noise_grad.dds"
	    {
			description( "The texture containing the gradient table used in "
						 "generating the noise." );
			disable_filtering();
			texture_coord_u("clamp");
		};
		float3   noise_position		  = float3(
							texture_coordinate[0].x,
							texture_coordinate[0].y,
							texture_coordinate[0].z)
    	{		
			display_name("Noise Position");
			description( "The location at which the noise function will be "
						 "evaluated." );			
		};
		float    noise_scale			  = 5.0
    	{			
			display_name("Noise Scale");
			soft_range(float(0.0001),float(100));
			description( "A scale factor applied to the position at which the "
						 "noise function will be evaluated." );
		};
		float    noise_lacunarity		  = 2.0
    	{			
			display_name("Noise Lacunarity");
			soft_range(float(0),float(4));
			description( "Factor separating noise frequencies "
			             "summed to generate the noise pattern." );
		};
		float    noise_gain			  = 0.5
    	{		
			display_name("Noise Gain");
			soft_range(float(0),float(1));
			description( "Factor which weights the noise frequencies summed "
			             " to generate the noise pattern." );
		};
    
	output:
		Color result;

		void main()
		{
			float3 posw = noise_position * noise_scale;

			float n;

			n = octaves(posw, 
						 noise_perm_texture, 
						 noise_grad_texture,
						 4, 
						 noise_lacunarity, 
						 noise_gain,
						 1.0,
						 0.5);
			n = n*0.5 + 0.5;

			result = Color(n.xxx, 1.0);
		}    
}
{
	description( "An operation that will generate a fractal noise pattern." );
}
;

