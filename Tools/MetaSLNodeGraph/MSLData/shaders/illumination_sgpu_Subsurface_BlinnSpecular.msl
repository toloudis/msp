/*****************************************************************************
 * Test version of a base shader for sgpu test compiler.
 *****************************************************************************/

shader Illumination_sgpu_Subsurface_BlinnSpecular
{
  input:    
  Color  g_BaseColor = Color(1,1,1,1)
  {	
      display_name("Base diffuse Color");
      hard_range(Color(0,0,0,0),Color(1,1,1,1));
      description( "Color from base map." );
  };
  float g_DiffuseFactor = 1.0
  {		
      display_name("Diffuse factor");
      hard_range(float(0),float(1));
      description( "diffuse lighting multiplier" );
  };
  Color  specular_color = Color(1,1,1,1)
  {	
      display_name("Specular Color");
      hard_range(Color(0,0,0,0),Color(1,1,1,1));
      description( "The color used to tint the Specular Reflectance Color." );
  };
  float specular_scalar = 0.7
  {		
      display_name("Specular Float");
      hard_range(float(0),float(1));
      description( "The intensity of the light specularly reflected from "
      "this surface." );
  };
  Color  g_translucency = Color(0,0,0,0)
  {	
      display_name("Translucency Color");
      hard_range(Color(0,0,0,0),Color(1,1,1,1));
      description( "Color from translucency map." );
  };
  float g_transMultiplier = 1.0
  {		
      display_name("Translucent Power");
      hard_range(float(0),float(2));
      description( "Translucent Power" );
  };
  float g_transRampOff = 1.0
  {		
      display_name("Translucent Ramp Off");
      hard_range(float(0),float(2));
      description( "translucent ramp off" );
  };
Color g_transColIn = Color(0.87, 0.91, 0.96, 1.0)
  {	
      display_name("Unscattered Color");
      hard_range(Color(0,0,0,0),Color(1,1,1,1));
      description( "unscattered color" );
  };
Color g_transColOut = Color(1.0, 0.71, 0.32, 1.0)
  {	
      display_name("Melanin Color");
      hard_range(Color(0,0,0,0),Color(1,1,1,1));
      description( "Melanin color" );
  };
Color g_transColBack = Color(0.58, 0.2, 0.24, 1.0)
  {	
      display_name("Hemoglobin Color");
      hard_range(Color(0,0,0,0),Color(1,1,1,1));
      description( "Hemoglobin color" );
  };
  float eccentricity = 0.5
  {		
      display_name("Eccentricity");
      hard_range(float(0),float(1));
      description( "Blinn specular highlight shape" );
  };
  float ior = 0.0
  {		
      display_name("IOR");
      hard_range(float(0),float(1));
      description( "Blinn index of refraction" );
  };
  float specularPower = 1.0
  {		
      display_name("Specular Power");
      hard_range(float(0),float(10));
      description( "Blinn specular power" );
  };

    
  output:
  Color result;
  Color diffuse;
  Color specular;

//=======================Translucency lighting model=======================
Color TransPass(float4 DotLN)
{
	float4 Translucence 	= smoothstep(-g_transRampOff  * g_translucency,float4(1,1,1,1),abs(DotLN)) 
					;//- smoothstep(float4(1,1,1,1),float4(1,1,1,1),DotLN); // or should it be step(float4(1,1,1,1), DotLN);//???
	
	float4 Colourise = lerp(g_transColBack, lerp(g_transColOut * g_transMultiplier,g_transColIn,DotLN),Translucence);
	
	return (Colourise * Translucence);
}



	// fresnel approximation
	float fastFresnel(float NdotE, float R0, float power)
	{
		// R(theta) = (1/2) ((g-c)/(g+c))^2 (1 + [ (c(g+c)-(eta)^2)/(c(g-c)+ (eta)^2) ]2)
		// approximate:
		// R(theta) ~= Ra(theta) = R(0) + (1-R(0))*(1-cos(theta))^5
	   return R0 + (1.0-R0)*pow(abs(1.0 - saturate(NdotE)), power);
	} 

	float fresnel(float NdotE, float eta)
	{
		// eta = ni/nt.
		// ni is usually 1 for air, and nt would be the IOR of the material.
		// that means we might want 1/IOR for eta.

		// R(theta) = (1/2) ((g-c)/(g+c))^2 (1 + [ (c(g+c)-(eta)^2)/(c(g-c)+ (eta)^2) ]2)
		// where:
		// cos(theta) = NdotV
		// c = eta*cos(theta)
		// g = sqrt(1 + c^2 - eta^2)

		// Note: compute R0 on the CPU and provide as a
		// constant; it is more efficient than computing R0 in
		// the shader. R0 is:
		// when theta = 0, c = eta and g = 1
		float R0 = (1.0-eta)*(1.0-eta)/((1.0+eta)*(1.0+eta));
		//float R0 = pow(1.0-eta, 2.0) / pow(1.0+eta, 2.0);
		
		// eye and normal are assumed to be normalized
		return fastFresnel(NdotE, R0, 5.0);
	}
	float BlinnSpecular(float3 i_normal, float3 i_lightDir, float3 i_eyeDir, 
		float i_eccentricity, float i_IOR,
		float i_specularPower)
	{
		// eyeDir is passed as dir FROM shade point TO eye
		// lightDir is passed as dir FROM shade point TO light

		float3 H = normalize(i_lightDir + i_eyeDir);
		// NdotH = cos a
		float NdotH = dot(i_normal, H);
		float NdotE = dot(i_normal, i_eyeDir);
		float EdotH = dot(i_eyeDir, H);
		float NdotL = dot(i_normal, i_lightDir);
		
		float Gb = 2 * NdotH * NdotE / EdotH;
		float Gc = 2 * NdotH * NdotL / EdotH; 
		float G = min(Gb, Gc);
		G = min(1, G);
		
		// eccentricity varies from 0 to 1. 
		// D3 = [ c^2 / (1 + cos^2(a)(c^2 - 1)) ]^2
		float c2 = i_eccentricity*i_eccentricity;
		float D3 = ( c2 / ( 1 + (NdotH*NdotH*(c2-1)) ) );
		float D = D3*D3;
		
		// eta = ni/nt. assume air-material is the interface
		float F = fresnel(NdotE, 1/(i_IOR+0.0001)); 

		float specComp = D * G * F / NdotE;
		specComp = max(specComp, 0);
		return (specComp * i_specularPower);
	}

//================================Pixel shader - Complete================================


  void main() 
  {
      diffuse = Color(0.0,0.0,0.0,0.0);
      specular = Color(0.0,0.0,0.0,0.0);
  
      Color Rs = specular_color * specular_scalar;

      	// enumerate lights
		Light_iterator light;
		foreach (light)
		{
			float4 DotLN		= float4(light.dot_nl,light.dot_nl,light.dot_nl,light.dot_nl);

			Color Translucency	= TransPass(DotLN);
			Color a = g_BaseColor;
			Color b 			= (Translucency);
			Color BaseLighting = (a * b)*(a + b + b - 2*a*b);

			specular += light.contribution * BlinnSpecular(normal, light.direction, -direction, 
				eccentricity, ior, specularPower);
			
			diffuse += BaseLighting * light.contribution * g_DiffuseFactor;
		}
      
      diffuse.a = 1.0;
      specular *= Rs;
      specular.a = 1.0;
      
      // irradiance term skipped
      
      result = diffuse + specular;
      result.a = 1.0;

  }
}
;

