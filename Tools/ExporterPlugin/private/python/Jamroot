# Specify the path to the Boost project.  If you move this project,
# adjust the path to refer to the Boost root directory.
use-project boost 
  : ../../../../../../boost_1_39_0 ;

# Set up the project-wide requirements that everything uses the
# boost_python library defined in the project whose global ID is
# /boost/python.
project sgpuExportLib-python 
 : requirements <library>/boost/python//boost_python 
 : requirements <include>./../../public/sgpuExportLib/include <threading>multi
 ;

lib sgpuLib : 
	: <file>./../../public/sgpuExportLib/lib/Win32/sgpuExportLib.lib
	;

# Make the definition of the python-extension rule available
import python ;

# Declare a Python extension called hello.
python-extension sgpuExportLib : sgpuExportLib.cpp  sgpuLib  ;

# Declare an executable called embedding that embeds Python
# exe sgpuExportLib : sgpuExportLib.cpp /python//python ;
