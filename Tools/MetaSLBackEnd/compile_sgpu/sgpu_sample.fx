void Illumination_sgpu_main(State state, Light_iterator light,
	float4 diffuse_color,
	float diffuse_scalar,
	out float4 result,
	out float4 diffuse)
{
	{
		diffuse = float4(0.0,0.0,0.0,0.0);
		float4 Rd = __color_ctor(float4(diffuse_color) * diffuse_scalar);
		float4 temp = Rd;
		float maxc = max(max(temp.r,temp.g),temp.b);
		if(maxc > 1.0)
			{
				Rd /= maxc;
			}
		//Light_iterator light;
