			{
				float cos = saturate(light.dot_nl);
				if(cos > 0.0)
					{
						diffuse += __color_ctor((cos / 3.14159265358979323846f) * float4(light.contribution));
					}
			}
		diffuse *= Rd;
		diffuse.a = 1.0;
		result = diffuse;
	}
}


