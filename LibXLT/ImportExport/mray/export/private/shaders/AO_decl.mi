#must match the struct in the cpp file for this shader!

$ifndef "sgpu_illum_AO_mi"
set "sgpu_illum_AO_mi" "true"

declare shader
	color "sgpu_illum_AO" (
				
		scalar			"g_transparency",
		color texture	"transparencyMap",
		
		scalar			"u_scale",
		scalar			"v_scale",
		scalar			"u_offset",
		scalar			"v_offset",
		scalar			"uv_rotation",
	
		color texture	"normalMap",
		scalar			"normalMapScale",
		
		boolean			"bEnableAO",
		color			"aoColor",
		scalar			"aoRadiusNear",
		scalar			"aoRadiusFar",
		scalar			"aoAngleBias",
		scalar			"aoAttenuation",
		scalar			"aoContrast",
		scalar			"aoCamNear",
		scalar			"aoCamFar",
		scalar			"aoSamples",
		
		integer			"mode",      # light selection mode 0,1,2,4
		array light		"lights"
	)
	version 1
	apply material
end declare

$endif
