<?xml version="1.0" encoding="utf-8"?>
<!--
    GraphicsVulkan: the Vulkan implementation of the LibXLT/Graphics
    abstractions (the counterpart of GraphicsDX11). Everything is in C++
    namespace gvk. Vulkan is the C API, loaded at run time with volk (no
    vulkan-1.lib); memory through Vulkan Memory Allocator. vcpkg.json next
    to this file lists the packages; vcpkg-configuration.json pins a newer
    baseline than the rest of the repo, matching the Vulkan SDK 1.4.350.

    volk's static library is merged into GraphicsVulkan.lib (Lib step
    below), so MainApp only references this project.
  -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug Qt|x64">
      <Configuration>Debug Qt</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug Wx|x64">
      <Configuration>Debug Wx</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release Qt|x64">
      <Configuration>Release Qt</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release Wx|x64">
      <Configuration>Release Wx</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug RenderNode|x64">
      <Configuration>Debug RenderNode</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release RenderNode|x64">
      <Configuration>Release RenderNode</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{216ED7AE-3E0C-4B0D-A1DF-8D4D80C8AD71}</ProjectGuid>
    <RootNamespace>GraphicsVulkan</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MspBaseConfiguration)' == 'Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MspBaseConfiguration)' == 'Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\bin\$(Platform)\$(Configuration)\lib\</OutDir>
    <IntDir>$(ProjectDir)..\bin\$(Platform)\$(Configuration)\obj\$(ProjectName)\</IntDir>
    <GvkVcpkgLib Condition="'$(MspBaseConfiguration)' == 'Debug'">$(ProjectDir)vcpkg_installed\x64-windows\x64-windows\debug\lib</GvkVcpkgLib>
    <GvkVcpkgLib Condition="'$(MspBaseConfiguration)' == 'Release'">$(ProjectDir)vcpkg_installed\x64-windows\x64-windows\lib</GvkVcpkgLib>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN64;_CRT_SECURE_NO_DEPRECATE;VK_NO_PROTOTYPES;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <DisableSpecificWarnings>4514;4127;4786;4100;4663;4018;4244;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <TreatWChar_tAsBuiltInType>true</TreatWChar_tAsBuiltInType>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <SuppressStartupBanner>true</SuppressStartupBanner>
    </ClCompile>
    <Lib>
      <AdditionalDependencies>volk.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(GvkVcpkgLib);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <SuppressStartupBanner>true</SuppressStartupBanner>
    </Lib>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MspBaseConfiguration)' == 'Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MspBaseConfiguration)' == 'Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="GraphicsVulkanLayer.cpp" />
    <ClCompile Include="vkd\private\vkdAdapter.cpp" />
    <ClCompile Include="vkd\private\vkdBindings.cpp" />
    <ClCompile Include="vkd\private\vkdCheck.cpp" />
    <ClCompile Include="vkd\private\vkdRingBuffer.cpp" />
    <ClCompile Include="vkd\private\vkdDevice.cpp" />
    <ClCompile Include="vkd\private\vkdImage.cpp" />
    <ClCompile Include="vkd\private\vkdSurfaceWin.cpp" />
    <ClCompile Include="vkd\private\vkdValidation.cpp" />
    <ClCompile Include="vkd\private\vkdVma.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="GraphicsVulkanLayer.hpp" />
    <ClInclude Include="vkd\vkdAdapter.hpp" />
    <ClInclude Include="vkd\vkdBindings.hpp" />
    <ClInclude Include="vkd\vkdCheck.hpp" />
    <ClInclude Include="vkd\vkdRingBuffer.hpp" />
    <ClInclude Include="vkd\private\vkdVma.hpp" />
    <ClInclude Include="vkd\vkdDevice.hpp" />
    <ClInclude Include="vkd\vkdImage.hpp" />
    <ClInclude Include="vkd\vkdInfo.hpp" />
    <ClInclude Include="vkd\vkdSurface.hpp" />
    <ClInclude Include="vkd\vkdValidation.hpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="vcpkg.json" />
    <None Include="vcpkg-configuration.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Core.vcxproj">
      <Project>{846C097D-3B0E-4A0A-B6D7-222ED73125F8}</Project>
    </ProjectReference>
    <ProjectReference Include="..\Graphics\Graphics.vcxproj">
      <Project>{1D25A739-3967-4BAF-AA18-53690B00BD55}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
