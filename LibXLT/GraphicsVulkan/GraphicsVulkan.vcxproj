  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- The built-in shaders: GraphicsDX11's HLSL, copied unchanged to Eff\private\Shaders
       (plus the Vulkan-only wrappers in Eff\private\ShadersVk, for stages DXC can't compile from the copy).
       Fx\private\EmbedShadersVk.ps1 compiles every entry point the *.effect.json manifests
       list with DXC to SPIR-V and embeds it with the manifests (included by
       Fx\private\fxEmbeddedShadersVk.cpp). DXC comes from this project's vcpkg packages. -->
  <PropertyGroup>
    <VkShaderDir>$(MSBuildThisFileDirectory)Eff\private\Shaders</VkShaderDir>
    <VkShaderScript>$(MSBuildThisFileDirectory)Fx\private\EmbedShadersVk.ps1</VkShaderScript>
    <VkShaderOutput>$(MSBuildThisFileDirectory)Fx\private\Generated\fxEmbeddedShadersVk.inc</VkShaderOutput>
    <VkDxc>$(MSBuildThisFileDirectory)vcpkg_installed\x64-windows\x64-windows\tools\directx-dxc\dxc.exe</VkDxc>
  </PropertyGroup>
  <ItemGroup>
    <VkShaderInput Include="$(VkShaderDir)\**\*.hlsl;$(VkShaderDir)\**\*.hlsli;$(VkShaderDir)\**\*.effect.json;$(MSBuildThisFileDirectory)Eff\private\ShadersVk\*.hlsl*;$(VkShaderScript)" />
  </ItemGroup>
  <Target Name="EmbedVkShaders" BeforeTargets="ClCompile" AfterTargets="VcpkgInstallManifestDependencies" Inputs="@(VkShaderInput)" Outputs="$(VkShaderOutput)">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(VkShaderScript)&quot; -ShaderDir &quot;$(VkShaderDir)&quot; -OutFile &quot;$(VkShaderOutput)&quot; -Dxc &quot;$(VkDxc)&quot;" />
  </Target>
  <!-- g2dFullscreenQuad's shaders (GraphicsVulkan only; DX11 compiles them from strings at run
       time), embedded the same way as table g2dQuadShadersVk (included by
       G2d\private\g2dFullscreenQuad.cpp). -->
  <PropertyGroup>
    <VkQuadShaderDir>$(MSBuildThisFileDirectory)G2d\private\Shaders</VkQuadShaderDir>
    <VkQuadShaderOutput>$(MSBuildThisFileDirectory)Fx\private\Generated\g2dQuadShadersVk.inc</VkQuadShaderOutput>
  </PropertyGroup>
  <ItemGroup>
    <VkQuadShaderInput Include="$(VkQuadShaderDir)\*.hlsl;$(VkQuadShaderDir)\*.effect.json;$(VkShaderScript)" />
  </ItemGroup>
  <Target Name="EmbedVkQuadShaders" BeforeTargets="ClCompile" AfterTargets="VcpkgInstallManifestDependencies" Inputs="@(VkQuadShaderInput)" Outputs="$(VkQuadShaderOutput)">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(VkShaderScript)&quot; -ShaderDir &quot;$(VkQuadShaderDir)&quot; -OutFile &quot;$(VkQuadShaderOutput)&quot; -Dxc &quot;$(VkDxc)&quot; -TableName g2dQuadShadersVk" />
  </Target>
</Project>
