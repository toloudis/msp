<?xml version="1.0" encoding="utf-8"?>
<!--
    GoogleTest unit tests for LibXLT/Core: a console exe that links Core
    (ProjectReference below) and gets gtest from the repository's
    vcpkg.json. vcpkg's x64-windows gtest is a DLL (gmock.dll, copied next to the
    exe).

    The Post-Build Event runs the tests right after linking, so a failing
    test fails the build; MainApp references this project, so MachStudio
    isn't built until the tests pass. The run also writes CoreTests.xml
    next to the exe (CI uploads it).

    The project has the solution's configurations (Debug/Release x
    Qt/Wx/RenderNode) only so that Core builds in the same configuration
    as MainApp; the tests don't use a GUI toolkit. Output goes to
    UnitTests/bin/<Platform>/<Configuration>/.
  -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A47F6EF0-4E08-4C1A-A930-CC4AF2BBE402}</ProjectGuid>
    <RootNamespace>CoreTests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MspBaseConfiguration)' == 'Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MspBaseConfiguration)' == 'Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)..\bin\$(Platform)\$(Configuration)\obj\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\LibXLT;$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- vcpkg's x64-windows gtest is a DLL -->
      <PreprocessorDefinitions>WIN64;_CONSOLE;_CRT_SECURE_NO_DEPRECATE;GTEST_LINKED_AS_SHARED_LIBRARY=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <DisableSpecificWarnings>4514;4127;4786;4100;4663;4018;4244;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <TreatWChar_tAsBuiltInType>true</TreatWChar_tAsBuiltInType>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <SuppressStartupBanner>true</SuppressStartupBanner>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <SuppressStartupBanner>true</SuppressStartupBanner>
    </Link>
    <PostBuildEvent>
      <Command>"$(TargetPath)" --gtest_brief=1 "--gtest_output=xml:$(OutDir)$(TargetName).xml"</Command>
      <Message>Running the unit tests</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MspBaseConfiguration)' == 'Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MspBaseConfiguration)' == 'Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="CoreTestsMain.cpp" />
    <ClCompile Include="ctPlatformWin.cpp" />
    <ClCompile Include="App\appCommandLineTest.cpp" />
    <ClCompile Include="Ch\chChunkTest.cpp" />
    <ClCompile Include="Ch\chMemWriterTest.cpp" />
    <ClCompile Include="Ch\chNumberTest.cpp" />
    <ClCompile Include="Dbg\dbgMsgTest.cpp" />
    <ClCompile Include="Env\envNumberTextTest.cpp" />
    <ClCompile Include="Env\envSTLHelpersTest.cpp" />
    <ClCompile Include="Env\envThreadGroupTest.cpp" />
    <ClCompile Include="Env\envWorkerThreadTest.cpp" />
    <ClCompile Include="Fs\fsFileTest.cpp" />
    <ClCompile Include="Fs\fsXMLTest.cpp" />
    <ClCompile Include="Geo\geoKDTreeTest.cpp" />
    <ClCompile Include="Gf\gfFileBinTest.cpp" />
    <ClCompile Include="It\itStringTest.cpp" />
    <ClCompile Include="Ma\maAxisBoxTest.cpp" />
    <ClCompile Include="Ma\maFunctionsTest.cpp" />
    <ClCompile Include="Ma\maMatrixTest.cpp" />
    <ClCompile Include="Ma\maPlaneTest.cpp" />
    <ClCompile Include="Ma\maRotationTest.cpp" />
    <ClCompile Include="Ma\maVectorTest.cpp" />
    <ClCompile Include="Name\nameObjectTest.cpp" />
    <ClCompile Include="Rel\relReferenceTest.cpp" />
    <ClCompile Include="Undo\undoUndoMgrTest.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="ctMath.hpp" />
    <ClInclude Include="ctNumbers.hpp" />
    <ClInclude Include="ctPlatform.hpp" />
    <ClInclude Include="ctTempDir.hpp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\LibXLT\Core\Core.vcxproj">
      <Project>{846C097D-3B0E-4A0A-B6D7-222ED73125F8}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
