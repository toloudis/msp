<?xml version="1.0" encoding="utf-8"?>
<!--
    Optionally runs a unit test executable right after it is built.

    Set MspRunUnitTests to true to turn this on, in any of these ways:
      - on the command line:      msbuild ... /p:MspRunUnitTests=true
      - as an environment variable (MSBuild reads them as properties):
                                  set MspRunUnitTests=true
      - for yourself only, in the IDE: add
            <PropertyGroup><MspRunUnitTests>true</MspRunUnitTests></PropertyGroup>
        to a git-ignored <Project>.vcxproj.user next to the test project.

    A failing test fails the build. CI runs the test executables in a
    separate step instead (see .github/workflows/build-windows.yml).
  -->
<Project>
  <Target Name="MspRunUnitTests"
          AfterTargets="Build"
          Condition="'$(MspRunUnitTests)' == 'true' and '$(ConfigurationType)' == 'Application'">
    <Exec Command="&quot;$(TargetPath)&quot; --gtest_brief=1"
          WorkingDirectory="$(OutDir)" />
  </Target>
</Project>
