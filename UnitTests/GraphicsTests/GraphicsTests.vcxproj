<?xml version="1.0" encoding="utf-8"?>
<!--
    GoogleTest unit tests for LibXLT/Graphics code that needs no GPU (the
    profiler, options, ...): a console exe that links Core and Graphics
    (ProjectReferences below) and gets gtest from vcpkg.json next to this
    file. Set up like CoreTests: the Post-Build Event runs the tests (a
    failure fails the build), MainApp references this project, output goes
    to UnitTests/bin/<Platform>/<Configuration>/.
  -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{35FADF25-2926-45F7-8F3D-19F065D16917}</ProjectGuid>
    <RootNamespace>GraphicsTests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MspBaseConfiguration)' == 'Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MspBaseConfiguration)' == 'Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)..\bin\$(Platform)\$(Configuration)\obj\$(ProjectName)\</IntDir>
    <!-- DXC and GraphicsVulkan's shader options; keep the options in step with
         LibXLT\GraphicsVulkan\Fx\private\EmbedShadersVk.ps1 and Tools\fx2hlsl\compile_check.py -->
    <GtDxc>"$(ProjectDir)..\..\LibXLT\GraphicsVulkan\vcpkg_installed\x64-windows\x64-windows\tools\directx-dxc\dxc.exe" -spirv -fspv-target-env=vulkan1.3 -fvk-use-dx-layout -fvk-use-dx-position-w -fvk-support-nonzero-base-instance -fvk-support-nonzero-base-vertex -fvk-b-shift 0 0 -fvk-t-shift 100 0 -fvk-s-shift 200 0 -fvk-u-shift 300 0</GtDxc>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\LibXLT;$(IntDir);$(ProjectDir)..\..\LibXLT\GraphicsVulkan\vcpkg_installed\x64-windows\x64-windows\include;$(ProjectDir)..\..\LibXLT\GraphicsDX11\vcpkg_installed\x64-windows\x64-windows\include;$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- vcpkg's x64-windows gtest is a DLL -->
      <PreprocessorDefinitions>WIN64;_CONSOLE;_CRT_SECURE_NO_DEPRECATE;NOMINMAX;GTEST_LINKED_AS_SHARED_LIBRARY=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <DisableSpecificWarnings>4514;4127;4786;4100;4663;4018;4244;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <TreatWChar_tAsBuiltInType>true</TreatWChar_tAsBuiltInType>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <SuppressStartupBanner>true</SuppressStartupBanner>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <SuppressStartupBanner>true</SuppressStartupBanner>
      <!-- Direct3D 11: GraphicsDX11 is the reference the Vulkan tests compare against
           (its headers ask for DirectXTex.lib, from its vcpkg packages). gtBackend brings up
           the whole DX11 and Graphics layers, which also need Graphics' OpenEXR (vcpkg) and
           libpng and zlibwapi (3rdParty), as MachStudio does -->
      <AdditionalDependencies>d3d11.lib;dxgi.lib;d3dcompiler.lib;libpng16.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories Condition="'$(MspBaseConfiguration)' == 'Debug'">$(ProjectDir)..\..\LibXLT\GraphicsDX11\vcpkg_installed\x64-windows\x64-windows\debug\lib;$(ProjectDir)..\..\LibXLT\Graphics\vcpkg_installed\x64-windows\x64-windows\debug\lib;$(ProjectDir)..\..\3rdParty\Libs\$(Platform);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalLibraryDirectories Condition="'$(MspBaseConfiguration)' == 'Release'">$(ProjectDir)..\..\LibXLT\GraphicsDX11\vcpkg_installed\x64-windows\x64-windows\lib;$(ProjectDir)..\..\LibXLT\Graphics\vcpkg_installed\x64-windows\x64-windows\lib;$(ProjectDir)..\..\3rdParty\Libs\$(Platform);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <PostBuildEvent>
      <Command>"$(TargetPath)" --gtest_brief=1 "--gtest_output=xml:$(OutDir)$(TargetName).xml"</Command>
      <Message>Running the unit tests</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MspBaseConfiguration)' == 'Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MspBaseConfiguration)' == 'Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="GraphicsTestsMain.cpp" />
    <ClCompile Include="gtPlatformWin.cpp" />
    <ClCompile Include="G3d\g3dProfilerTest.cpp" />
    <ClCompile Include="Vk\vkdAdapterTest.cpp" />
    <ClCompile Include="Vk\vkdDeviceTest.cpp" />
    <ClCompile Include="Vk\vkdValidationTest.cpp" />
    <ClCompile Include="Vk\vkdRingBufferTest.cpp" />
    <ClCompile Include="Vk\vkdBindingsTest.cpp" />
    <ClCompile Include="Vk\g2dWindowVkTest.cpp" />
    <ClCompile Include="Vk\g2dSystemVkTest.cpp" />
    <ClCompile Include="Vk\GraphicsVulkanLayerTest.cpp" />
    <ClCompile Include="Vk\fxShaderCopyTest.cpp" />
    <ClCompile Include="Dx11\gtD3D11.cpp" />
    <ClCompile Include="Vk\fxEffectVkReflectionTest.cpp" />
    <ClCompile Include="Vk\vkdPipelineCacheTest.cpp" />
    <ClCompile Include="Vk\vkdContextTest.cpp" />
    <ClCompile Include="Vk\fxEffectVkTest.cpp" />
    <ClCompile Include="Vk\effPlainEffectVkTest.cpp" />
    <ClCompile Include="gtImage.cpp" />
    <ClCompile Include="gtImageTest.cpp" />
    <ClCompile Include="Vk\g2dFullscreenQuadTest.cpp" />
    <ClCompile Include="Vk\fxParityTest.cpp" />
    <ClCompile Include="Vk\vkdFormatTest.cpp" />
    <ClCompile Include="Vk\vkdImageTest.cpp" />
    <ClCompile Include="Vk\vkdBufferTest.cpp" />
    <ClCompile Include="Vk\tiffVcpkgTest.cpp" />
    <ClCompile Include="gtImageFiles.cpp" />
    <ClCompile Include="Vk\matImageDecodeTest.cpp" />
    <ClCompile Include="Vk\matMipFilterTest.cpp" />
    <ClCompile Include="gtBackend.cpp" />
    <ClCompile Include="Vk\matTextureMgrVkTest.cpp" />
    <ClCompile Include="gtScene.cpp" />
    <ClCompile Include="Vk\bumpFragmentVkTest.cpp" />
    <ClCompile Include="Vk\effShaderVkTest.cpp" />
    <ClCompile Include="gtTarget.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="gtPlatform.hpp" />
    <ClInclude Include="gtTempDir.hpp" />
    <ClInclude Include="Vk\gtVulkan.hpp" />
    <ClInclude Include="Dx11\gtD3D11.hpp" />
    <ClInclude Include="gtImage.hpp" />
    <ClInclude Include="Vk\gtVulkanContext.hpp" />
    <ClInclude Include="gtImageFiles.hpp" />
    <ClInclude Include="gtBackend.hpp" />
    <ClInclude Include="gtScene.hpp" />
    <ClInclude Include="gtTarget.hpp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test shaders: VSMain and PSMain of each, compiled to SPIR-V with GraphicsVulkan's
         options into headers g_<name>VS / g_<name>PS ($(IntDir)<name>VS.h, <name>PS.h) -->
    <CustomBuild Include="Vk\Shaders\gtBindingProto.hlsl" />
    <CustomBuild Include="Vk\Shaders\gtSolid.hlsl" />
    <CustomBuild Include="Vk\Shaders\gtTexel.hlsl" />
    <CustomBuild Include="Vk\Shaders\gtTexel3D.hlsl">
      <AdditionalInputs>%(RootDir)%(Directory)gtTexel.hlsl</AdditionalInputs>
    </CustomBuild>
  </ItemGroup>
  <ItemDefinitionGroup>
    <CustomBuild>
      <Command>$(GtDxc) -T vs_6_0 -E VSMain -Vn g_%(Filename)VS -Fh "$(IntDir)%(Filename)VS.h" "%(FullPath)" &amp;&amp; $(GtDxc) -T ps_6_0 -E PSMain -Vn g_%(Filename)PS -Fh "$(IntDir)%(Filename)PS.h" "%(FullPath)"</Command>
      <Message>DXC (SPIR-V) %(Filename)%(Extension)</Message>
      <Outputs>$(IntDir)%(Filename)VS.h;$(IntDir)%(Filename)PS.h</Outputs>
    </CustomBuild>
  </ItemDefinitionGroup>
  <ItemGroup>
    <None Include="vcpkg.json" />
    <None Include="vcpkg-configuration.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\LibXLT\Core\Core.vcxproj">
      <Project>{846C097D-3B0E-4A0A-B6D7-222ED73125F8}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\LibXLT\Graphics\Graphics.vcxproj">
      <Project>{1D25A739-3967-4BAF-AA18-53690B00BD55}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\LibXLT\GraphicsDX11\GraphicsDX11.vcxproj">
      <Project>{419458FF-14D9-40EC-A36E-0A72774BC100}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\LibXLT\GraphicsVulkan\GraphicsVulkan.vcxproj">
      <Project>{216ED7AE-3E0C-4B0D-A1DF-8D4D80C8AD71}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- The DLLs the Graphics and GraphicsDX11 libraries need at run time (their vcpkg
       packages, libpng and zlibwapi), next to the exe before the tests run (as MainApp's
       CopyLibraryVcpkgDlls); the test project's own vcpkg DLLs are left as they are -->
  <Target Name="CopyLibraryDlls" BeforeTargets="PostBuildEvent">
    <PropertyGroup>
      <LibraryVcpkgBin Condition="'$(MspBaseConfiguration)'=='Debug'">debug\bin</LibraryVcpkgBin>
      <LibraryVcpkgBin Condition="'$(MspBaseConfiguration)'=='Release'">bin</LibraryVcpkgBin>
    </PropertyGroup>
    <ItemGroup>
      <LibraryDll Include="$(ProjectDir)..\..\LibXLT\Graphics\vcpkg_installed\x64-windows\x64-windows\$(LibraryVcpkgBin)\*.dll" />
      <LibraryDll Include="$(ProjectDir)..\..\LibXLT\GraphicsDX11\vcpkg_installed\x64-windows\x64-windows\$(LibraryVcpkgBin)\*.dll" />
      <LibraryDll Include="$(ProjectDir)..\..\3rdParty\Libs\$(Platform)\libpng16.dll;$(ProjectDir)..\..\3rdParty\Libs\$(Platform)\zlibwapi.dll" />
    </ItemGroup>
    <Copy SourceFiles="%(LibraryDll.Identity)" DestinationFolder="$(OutDir)" Condition="!Exists('$(OutDir)%(LibraryDll.Filename)%(LibraryDll.Extension)')" />
  </Target>
</Project>
